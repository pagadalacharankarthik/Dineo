generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  emailVerified  Boolean         @default(false)
  image          String?
  mobile         String?
  role           UserRole        @default(RESTAURANT_OWNER)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  passwordResets PasswordReset[]
  restaurant     Restaurant?
  sessions       Session[]

  @@map("users")
}

model Restaurant {
  id                     String     @id @default(cuid())
  name                   String
  slug                   String     @unique
  logo                   String?
  coverImage             String?
  description            String?
  address                String?
  city                   String?
  state                  String?
  country                String?
  pincode                String?
  mobile                 String?
  email                  String?
  website                String?
  instagram              String?
  facebook               String?
  openingTime            String?
  closingTime            String?
  isActive               Boolean    @default(true)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  ownerId                String     @unique
  isDeleted              Boolean    @default(false)
  isSuspended            Boolean    @default(false)
  planExpiresAt          DateTime?
  planName               String     @default("FREE_TRIAL")
  planStatus             String     @default("ACTIVE")
  trialEndDate           DateTime?
  trialStartDate         DateTime   @default(now())
  googleReviewUrl        String?
  showOfferBanner        Boolean    @default(false)
  showTrialBanner        Boolean    @default(true)
  themeColor             String?    @default("orange")
  razorpayCustomerId     String?
  razorpaySubscriptionId String?    @unique
  categories             Category[]
  coupons                Coupon[]
  menuItems              MenuItem[]
  qrCodes                QRCode[]
  owner                  User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("restaurants")
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  isHidden     Boolean    @default(false)
  isDisabled   Boolean    @default(false)
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  viewsCount   Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@index([restaurantId])
  @@map("categories")
}

model MenuItem {
  id            String     @id @default(cuid())
  restaurantId  String
  categoryId    String
  name          String
  description   String?
  price         Float
  imageUrl      String?
  isVeg         Boolean    @default(true)
  isRecommended Boolean    @default(false)
  isBestSeller  Boolean    @default(false)
  isChefSpecial Boolean    @default(false)
  isAvailable   Boolean    @default(true)
  isHidden      Boolean    @default(false)
  displayOrder  Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  viewsCount    Int        @default(0)
  discountPrice Float?
  category      Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_items")
}

model QRCode {
  id             String     @id @default(cuid())
  restaurantId   String
  code           String     @unique
  targetUrl      String
  qrType         QRType     @default(RESTAURANT_MAIN)
  scansCount     Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  downloadsCount Int        @default(0)
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  scans          QRScan[]

  @@index([restaurantId])
  @@map("qr_codes")
}

model QRScan {
  id           String   @id @default(cuid())
  qrCodeId     String
  restaurantId String
  scannedAt    DateTime @default(now())
  deviceType   String?
  browser      String?
  os           String?
  city         String?
  country      String?
  referrer     String?
  visitorId    String?
  qrCode       QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([qrCodeId])
  @@index([scannedAt])
  @@map("qr_scans")
}

model ContactEnquiry {
  id             String        @id @default(cuid())
  name           String
  restaurantName String?
  email          String
  phone          String?
  message        String
  isRead         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  status         EnquiryStatus @default(NEW)
  updatedAt      DateTime      @updatedAt
  qrColor        String?

  @@map("contact_enquiries")
}

model QRKitRequest {
  id             String      @id @default(cuid())
  restaurantName String
  contactPerson  String
  phone          String
  email          String
  address        String
  city           String
  state          String
  pincode        String
  tableCount     Int
  quantityNeeded Int
  notes          String?
  status         QRKitStatus @default(PENDING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  qrColor        String      @default("orange")

  @@map("qr_kit_requests")
}

model Coupon {
  id            String     @id @default(cuid())
  restaurantId  String
  code          String
  discountType  String     @default("PERCENT")
  discountValue Float
  isActive      Boolean    @default(true)
  expiresAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, code])
  @@map("coupons")
}

model AdminUser {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         AdminRole      @default(SUPER_ADMIN)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("admin_sessions")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model AdminOTP {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("admin_otps")
}

model GlobalSettings {
  id                   String   @id @default("singleton")
  guestBannerActive    Boolean  @default(true)
  guestBannerText      String   @default("🎉 Special Launch Offer: Get 20% off physical NFC standee kits. Register your restaurant now!")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  merchantBannerActive Boolean  @default(true)
  merchantBannerText   String   @default("🎉 Exclusive Offer: Get 20% Off your first order of physical NFC Table Standees! Request your kit today.")

  @@map("global_settings")
}

enum UserRole {
  SUPER_ADMIN
  RESTAURANT_OWNER
}

enum QRKitStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  CONTACTED
  IN_PROGRESS
  COMPLETED
}

enum QRType {
  RESTAURANT_MAIN
  TABLE_SPECIFIC
}

enum EnquiryStatus {
  NEW
  REPLIED
  CLOSED
}

enum AdminRole {
  SUPER_ADMIN
}

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String    @default("PERCENT") // "PERCENT" or "FLAT"
  discountValue Float
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("promo_codes")
}
